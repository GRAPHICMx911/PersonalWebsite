# ==============================================================================
# PERSONAL GLOBAL WEBSITE & CMS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' (or 'backend/.env') and customize for your deployment environment.
# Never commit actual production secrets or credentials to version control.
# ==============================================================================

# Database Connection URL (PostgreSQL with psycopg 3 driver)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:your_secure_password@localhost:5432/personal_website_db

# Security & JSON Web Token (JWT) Settings
# Generate a cryptographically strong 256-bit secret using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_cryptographically_secure_random_256_bit_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backward-compatibility aliases
SECRET_KEY=your_cryptographically_secure_random_256_bit_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cross-Origin Resource Sharing (CORS) Allowed Origins
# Comma-separated list of origins authorized to make cross-origin requests
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://muneebahmad.netlify.app

# Server Environment Mode ('production' or 'development')
ENVIRONMENT=production
